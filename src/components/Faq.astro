---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].faq;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container grid">
    <h2 id="faq-title">{t.title}</h2>
    <div class="items">
      {
        t.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--s-5) var(--s-8);
  }

  .items {
    border-top: 1px solid var(--rule);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    padding-block: var(--s-5);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    width: 1em;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink-3);
  }

  details[open] summary::after {
    content: '−';
  }

  summary:hover::after {
    color: var(--ink);
  }

  details p {
    padding-bottom: var(--s-5);
    color: var(--ink-2);
    max-width: 40em;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
