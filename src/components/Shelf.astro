---
// The hero picture: the publishers we carry, as spines on a shelf.
// Tones stay inside the palette: ink, the main colour and its tints, the logo's navy, paper.

interface Props {
  caption: string;
}

const books = [
  { name: 'Oxford University Press', h: 0.93, w: 64, tone: 'ink' },
  { name: 'Usborne', h: 0.66, w: 52, tone: 'pale', top: true },
  { name: 'Cambridge University Press', h: 0.86, w: 58, tone: 'paper' },
  { name: 'Pearson', h: 0.72, w: 50, tone: 'main', top: true },
  { name: 'Macmillan', h: 0.84, w: 56, tone: 'navy' },
  // Leans on Macmillan, which must stay taller than this book's top corner.
  { name: 'Penguin Readers', h: 0.77, w: 48, tone: 'mist', lean: true },
];
---

<figure class="shelf">
  <div class="books" role="list">
    {
      books.map((b) => (
        <div
          role="listitem"
          class:list={['book', b.tone, { top: b.top, lean: b.lean }]}
          style={`--h:${b.h};--w:${b.w}`}
        >
          <span>{b.name}</span>
        </div>
      ))
    }
  </div>
  <figcaption>{Astro.props.caption}</figcaption>
</figure>

<style>
  .shelf {
    --shelf-h: 340px;
    --scale: 1;
    margin: 0;
  }

  .books {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: var(--shelf-h);
    padding-inline: 4px;
    border-bottom: 4px solid var(--ink);
  }

  .book {
    position: relative;
    flex: none;
    height: calc(var(--shelf-h) * var(--h));
    width: calc(var(--w) * 1px * var(--scale));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px 3px 1px 1px;
  }

  /* Headbands: the two thin rules near the ends of a cloth spine */
  .book::before,
  .book::after {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    border-top: 1px solid currentColor;
    opacity: 0.35;
  }

  .book::before {
    top: 12px;
  }

  .book::after {
    bottom: 12px;
  }

  .book span {
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(15px * var(--scale));
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .book.top {
    align-items: flex-start;
    padding-top: 26px;
  }

  .ink {
    background: var(--ink);
    color: #eef1f6;
  }

  .paper {
    background: var(--paper);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .main {
    background: var(--accent);
    color: var(--on-accent);
  }

  .navy {
    background: var(--navy);
    color: #e6edf6;
  }

  .pale {
    background: #cdeaf2;
    color: var(--ink);
  }

  .mist {
    background: #e8f3f7;
    color: var(--ink);
  }

  /* The last book leans on its neighbour, resting on its bottom-left corner */
  .lean {
    transform-origin: bottom left;
    transform: rotate(-9deg);
    margin-left: calc(var(--shelf-h) * var(--h) * 0.156 - 3px);
  }

  figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .shelf {
      --shelf-h: 300px;
      --scale: 0.88;
    }
  }

  @media (max-width: 420px) {
    .shelf {
      --shelf-h: 250px;
      --scale: 0.78;
    }
  }
</style>
