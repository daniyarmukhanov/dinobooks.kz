---
import { CONTACT, content, mailLink, waLink, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const all = content[Astro.props.lang];
const t = all.contact;

const channels = [
  { label: 'WhatsApp', value: CONTACT.phoneDisplay, hint: t.whatsappHint, href: waLink(all.wa.school), external: true },
  { label: 'Email', value: CONTACT.email, hint: t.emailHint, href: mailLink(all.emailSubject), external: false },
  { label: 'Instagram', value: CONTACT.instagramHandle, hint: t.instagramHint, href: CONTACT.instagram, external: true },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul class="channels">
      {
        channels.map((c) => (
          <li>
            <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="label">{c.label}</span>
              <span class="value">{c.value}</span>
              <span class="hint">{c.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="city">{t.city}</p>
  </div>
</section>

<style>
  .contact {
    background: var(--accent);
    color: var(--on-accent);
    padding-block: clamp(4rem, 2.5rem + 5vw, 7rem);
  }

  h2 {
    color: var(--on-accent);
  }

  .lead {
    margin-top: var(--s-4);
    color: var(--on-accent-2);
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-7);
  }

  .channels a {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.45);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms var(--ease);
  }

  .channels a:hover {
    border-top-color: var(--on-accent);
  }

  .label {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--on-accent-2);
  }

  .value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    /* deslop-ignore-next-line 09 -- link underline, shown on hover */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    transition: text-decoration-color 150ms var(--ease);
    overflow-wrap: anywhere;
  }

  .channels a:hover .value {
    text-decoration-color: var(--on-accent);
  }

  .hint {
    font-size: var(--t-sm);
    color: var(--on-accent-2);
  }

  .city {
    margin-top: var(--s-7);
    font-size: var(--t-sm);
    color: var(--on-accent-2);
  }

  .contact :focus-visible {
    outline-color: var(--on-accent);
  }

  @media (max-width: 800px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
  }
</style>
