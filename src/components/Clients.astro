---
import { SCHOOLS, content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang];
---

<section class="clients" aria-labelledby="clients-title">
  <div class="container grid">
    <div class="intro">
      <h2 id="clients-title">{t.clients.title}</h2>
      <p>{t.clients.text}</p>
    </div>
    <ul class="names">
      {SCHOOLS.map((name) => <li>{name}</li>)}
      <li class="more">{t.clients.more}</li>
    </ul>
  </div>
</section>

<style>
  .clients {
    background: var(--paper-2);
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--s-7);
  }

  h2 {
    font-size: var(--t-h3);
  }

  .intro p {
    margin-top: var(--s-3);
    color: var(--ink-2);
    max-width: 22em;
  }

  .names {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }

  .names li {
    padding: var(--s-4) var(--s-5) var(--s-5) 0;
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 1.15rem + 0.6vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .names .more {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--t-base);
    color: var(--ink-3);
    align-self: end;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
  }

  @media (max-width: 560px) {
    .names {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
